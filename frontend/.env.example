# Copy to .env.local (never committed) and fill in.
#
# The network dropdown in the app lets you switch between these at runtime, so each one needs its
# own deployed contract address — a contract deployed on testnet doesn't exist on mainnet, or on
# the local Hardhat node. Leave one blank if you haven't deployed there; the app will just show
# "No contract configured" for that network instead of a countdown.
VITE_FLASHDROP_ADDRESS_TESTNET=""
VITE_FLASHDROP_ADDRESS_MAINNET=""
VITE_FLASHDROP_ADDRESS_LOCAL=""

# Which network is pre-selected on load (5042002 = Arc Testnet, 5042 = Arc Mainnet, 31337 = local
# Hardhat node). Defaults to Arc Testnet if unset or unrecognized — the safe choice while testing.
VITE_CHAIN_ID="5042002"

VITE_ARC_TESTNET_RPC_URL="https://rpc.testnet.arc.io"
VITE_ARC_MAINNET_RPC_URL="https://rpc.mainnet.arc.io"

VITE_PRODUCT_NAME="Free Fall"
VITE_PRODUCT_DESCRIPTION="The price is in free fall. First confirmed buyer wins it."

# Seconds of "earlier price" headroom signed into the Permit2 permit, to absorb network latency
# and client clock drift between signing and the buy() transaction landing. See the comment above
# `safetyMarginSeconds` in src/lib/useFlashDrop.ts for why this can only ever reduce reverts, never
# cause an overpay (the contract always charges the actual on-chain price, never more).
VITE_PERMIT_SAFETY_MARGIN_SECONDS="10"
